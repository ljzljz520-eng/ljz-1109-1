    {
      "id": "applique",
      "name": "贴布绣",
      "otherNames": ["补花", "贴花"],
      "difficulty": "low",
      "region": "川黔滇、黔中",
      "use": "块面对比强烈的图案与儿童服饰",
      "thread": "剪花布料与锁边彩线",
      "summary": "把彩色布料剪成纹样形状贴在底布上，沿边以锁绣或短针钉牢，再在贴片上加绣细节，色块鲜明、结实耐磨。",
      "diagram": {
        "viewBox": [0, 0, 320, 200],
        "fabric": {"x": 8, "y": 8, "w": 304, "h": 184, "fill": "#16324f"},
        "steps": [
          {
            "title": "纸样定位",
            "instruction": "在深色底布上摆好剪好的纸样，贴布绣重色块对比，先确定中心。",
            "elements": [
              {"tag": "path", "attrs": {"d": "M160 44 L194 128 L126 128 Z", "fill": "none", "stroke": "#e8d9a8", "stroke-width": 1.6, "stroke-dasharray": "5 4"}}
            ]
          },
          {
            "title": "剪贴布片",
