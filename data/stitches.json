    {
      "id": "satin",
      "name": "破线平绣",
      "otherNames": ["平绣", "破线绣"],
      "difficulty": "medium",
      "region": "黔东南施洞",
      "use": "人物、花卉、蝴蝶等细腻主题",
      "thread": "丝绒线破成细丝，上皂角液顺滑",
      "summary": "将一根丝线破为多缕细丝，按纹样轮廓以长短一致的直针平铺填色，绣面平滑光亮、过渡细腻，是施洞苗绣最具代表性的针法。",
      "diagram": {
        "viewBox": [0, 0, 320, 200],
        "fabric": {"x": 8, "y": 8, "w": 304, "h": 184, "fill": "#f3ead6"},
        "steps": [
          {
            "title": "起稿定位",
            "instruction": "在缎面上描出叶片轮廓，确定起针方向；平绣丝线顺着纹样走向平铺。",
            "elements": [
              {"tag": "path", "attrs": {"d": "M160 36 C205 60 225 110 160 168 C95 110 115 60 160 36 Z", "fill": "none", "stroke": "#8a6d3b", "stroke-width": 2, "stroke-dasharray": "5 4"}}
            ]
          },
          {
            "title": "从尖端起针",
            "instruction": "在叶尖正面下第一针，背面藏好线头，针距约 2–3 毫米。",
            "elements": [
              {"tag": "line", "attrs": {"x1": 160, "y1": 36, "x2": 160, "y2": 56, "class": "thread-satin"}}
            ]
          },
          {
            "title": "平行铺线",
            "instruction": "一针紧挨一针平行排列，丝缕统一，先铺一侧再铺另一侧，不重叠不露底。",
            "elements": [
              {"tag": "line", "attrs": {"x1": 137, "y1": 50, "x2": 150, "y2": 70, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 183, "y1": 50, "x2": 170, "y2": 70, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 124, "y1": 70, "x2": 143, "y2": 88, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 196, "y1": 70, "x2": 177, "y2": 88, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 117, "y1": 92, "x2": 140, "y2": 106, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 203, "y1": 92, "x2": 180, "y2": 106, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 115, "y1": 114, "x2": 141, "y2": 124, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 205, "y1": 114, "x2": 179, "y2": 124, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 122, "y1": 136, "x2": 147, "y2": 142, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 198, "y1": 136, "x2": 173, "y2": 142, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 138, "y1": 156, "x2": 154, "y2": 158, "class": "thread-satin"}},
              {"tag": "line", "attrs": {"x1": 182, "y1": 156, "x2": 166, "y2": 158, "class": "thread-satin"}}
            ]
          },
          {
            "title": "勾出主脉",
            "instruction": "换深一度的色线，沿叶中心绣一条主脉，压住两侧铺线的收口。",
            "elements": [
              {"tag": "path", "attrs": {"d": "M160 38 C158 80 158 120 160 166", "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "stroke-linecap": "round"}}
            ]
          },
          {
            "title": "分色过渡",
            "instruction": "相邻花瓣换色时以深浅区分层次，破丝越细，混色越柔和。",
            "elements": [
              {"tag": "path", "attrs": {"d": "M92 120 C100 96 118 82 138 78", "fill": "none", "stroke": "#0f7b6c", "stroke-width": 2.4, "stroke-linecap": "round"}},
              {"tag": "path", "attrs": {"d": "M228 120 C220 96 202 82 182 78", "fill": "none", "stroke": "#0f7b6c", "stroke-width": 2.4, "stroke-linecap": "round"}}
            ]
          },
          {
            "title": "收边完成",
            "instruction": "沿外缘压一圈细轮廓线，修剪反面线头，绣面平整如绘即完成。",
            "elements": [
              {"tag": "path", "attrs": {"d": "M160 36 C205 60 225 110 160 168 C95 110 115 60 160 36 Z", "fill": "none", "stroke": "#16324f", "stroke-width": 2}},
              {"tag": "text", "attrs": {"x": 160, "y": 192, "text-anchor": "middle", "class": "svg-caption", "data-text": "平整如绘 · 破线平绣"}}
            ]
          }
        ]
      }
    },
    {
      "id": "chain",
      "name": "锁绣",
      "otherNames": ["辫子股", "连环针"],
      "difficulty": "low",
      "region": "川黔滇、湘西",
      "use": "勾边、轮廓线与块面填绣",
      "thread": "双股绒线或丝线",
      "summary": "每一针在出针处挽一个线圈，下一针从线圈中穿出再拉紧，环环相扣如辫链，是最古老的绣法之一，线条连绵富弹性。",
      "diagram": {
        "viewBox": [0, 0, 320, 200],
        "fabric": {"x": 8, "y": 8, "w": 304, "h": 184, "fill": "#f3ead6"},
        "steps": [
          {
            "title": "画走线基线",
            "instruction": "在绣布上确定锁绣要走的曲线，锁绣适合勾轮廓，先轻描一条引导线。",
            "elements": [
              {"tag": "path", "attrs": {"d": "M36 104 C100 60 220 60 284 100", "fill": "none", "stroke": "#8a6d3b", "stroke-width": 1.6, "stroke-dasharray": "5 4"}}
            ]
          },
          {
            "title": "出针挽圈",
            "instruction": "针从布背向上穿出，随即把线在针尖前挽一个小圈，暂不收紧。",
            "elements": [
              {"tag": "circle", "attrs": {"cx": 44, "cy": 100, "r": 6, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4}},
              {"tag": "circle", "attrs": {"cx": 44, "cy": 100, "r": 2, "fill": "#7a1f2b"}}
            ]
          },
          {
            "title": "回针刺布",
            "instruction": "针紧挨原出针点扎回布面，从圈内穿过，在前方约 4 毫米处再穿出。",
            "elements": [
              {"tag": "ellipse", "attrs": {"cx": 62, "cy": 95, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(18 62 95)"}},
              {"tag": "circle", "attrs": {"cx": 62, "cy": 95, "r": 1.8, "fill": "#7a1f2b"}}
            ]
          },
          {
            "title": "连环推进",
            "instruction": "重复挽圈—穿圈—出针，后一圈穿过前一圈的心，形成连续链条。",
            "elements": [
              {"tag": "ellipse", "attrs": {"cx": 82, "cy": 89, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(14 82 89)"}},
              {"tag": "ellipse", "attrs": {"cx": 104, "cy": 84, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(9 104 84)"}},
              {"tag": "ellipse", "attrs": {"cx": 127, "cy": 81, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(4 127 81)"}},
              {"tag": "ellipse", "attrs": {"cx": 150, "cy": 81, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4}}
            ]
          },
          {
            "title": "拉紧调距",
            "instruction": "每穿一针顺势匀力拉线，线圈大小保持一致，链节才整齐圆润。",
            "elements": [
              {"tag": "ellipse", "attrs": {"cx": 173, "cy": 83, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(-5 173 83)"}},
              {"tag": "ellipse", "attrs": {"cx": 196, "cy": 87, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(-9 196 87)"}},
              {"tag": "ellipse", "attrs": {"cx": 218, "cy": 92, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(-13 218 92)"}},
              {"tag": "ellipse", "attrs": {"cx": 239, "cy": 96, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(-10 239 96)"}},
              {"tag": "ellipse", "attrs": {"cx": 259, "cy": 99, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(-6 259 99)"}}
            ]
          },
          {
            "title": "收针固定",
            "instruction": "走到末端不再挽圈，针从最后一圈中穿出后直接扎回背面打结固定。",
            "elements": [
              {"tag": "ellipse", "attrs": {"cx": 278, "cy": 100, "rx": 5, "ry": 7.5, "fill": "none", "stroke": "#7a1f2b", "stroke-width": 2.4, "transform": "rotate(-2 278 100)"}},
              {"tag": "path", "attrs": {"d": "M280 100 l8 2", "stroke": "#16324f", "stroke-width": 2, "stroke-linecap": "round"}},
              {"tag": "text", "attrs": {"x": 160, "y": 186, "text-anchor": "middle", "class": "svg-caption", "data-text": "环环相扣 · 锁绣"}}
            ]
          }
        ]
      }
    },
    {
